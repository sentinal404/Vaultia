<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vaultia" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vaultia_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ (API 31+) SplashScreen system attributes -->
        <item name="android:windowSplashScreenBackground">@color/vaultia_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/vaultia_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/vaultia_splash_bg</item>
    </style>
</resources>
